{
  "name": "wikitongues-db",
  "version": "0.2.0",
  "description": "Lightweight, zero-dependency database and query library mapping ISO 639-3, Glottolog and BCP 47 language classifications to Wikitongues oral history video recordings.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./data": {
      "types": "./dist/dataset.d.ts",
      "import": "./dist/dataset.mjs",
      "require": "./dist/dataset.js",
      "default": "./data/processed/wikitongues_normalized.json"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "data/processed/wikitongues_normalized.json",
    "data/processed/wikitongues_normalized.jsonl",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run build:reference && tsup",
    "build:reference": "tsx pipeline/scripts/build_reference.ts",
    "test": "vitest run tests/",
    "test:pipeline": "vitest run pipeline/__tests__/",
    "test:e2e": "vitest run pipeline/__tests__/e2e_youtube.test.ts",
    "test:all": "vitest run",
    "extract:youtube": "tsx pipeline/scripts/extract_youtube.ts",
    "download:subtitles": "tsx pipeline/scripts/download_subtitles.ts",
    "dataset:diff": "tsx pipeline/scripts/diff_dataset.ts",
    "dataset:status": "tsx pipeline/scripts/diff_dataset.ts",
    "typecheck": "tsc --noEmit",
    "examples": "tsx examples.ts",
    "demo": "tsx demos/run-all.ts",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "wikitongues",
    "languages",
    "iso639-3",
    "bcp47",
    "glottolog",
    "linguistics",
    "oral-history",
    "videos",
    "dataset",
    "search"
  ],
  "author": "Panglotive Team <contact@panglotive.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yro7/wikitongues-db"
  },
  "homepage": "https://github.com/yro7/wikitongues-db#readme",
  "bugs": {
    "url": "https://github.com/yro7/wikitongues-db/issues"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "tsup": "^8.4.0",
    "tsx": "^4.23.13",
    "typescript": "^5.7.3",
    "vitest": "^3.0.8"
  }
}
